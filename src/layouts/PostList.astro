---
import Button from "@/components/Button.astro";
import Subtitle from "@/components/Subtitle.astro";
import type { CollectionEntry } from "astro:content";

const { posts } = Astro.props;
const tags: Array<[string, number]> = [
  ...posts
    .flatMap((article: CollectionEntry<"blog">) => article.data.tags ?? [])
    .reduce((acc, e) => acc.set(e, (acc.get(e) || 0) + 1), new Map()),
].sort((a, b) => {
  return b[1] - a[1];
});
const title = {cn:"文章列表",en:"POSTLINK"};
const subtitle = `共 ${posts.length} 篇文章`;
---

<main class="p-14">
  <Subtitle {title} {subtitle} />
  <br />
  <div class="flex flex-wrap gap-2">
    {tags.map(([tagName, count]) => (
      <Button url=`/tags/${encodeURIComponent(tagName)}/`>
        {tagName}({count})
      </Button>
    ))}
  </div>
  {posts.map((article: CollectionEntry<"blog">) => (
    <article class="group pb-6 pt-4">
      <span>{article.data.pubDate}</span> -{" "}
      <a
        class="hover:text-blue-400 hover:underline underline-offset-4"
        href=`/posts/${article.id}/`
      >
        {article.data.title}
      </a>
    </article>
  ))}
</main>
