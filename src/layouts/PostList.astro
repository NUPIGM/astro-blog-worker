---
import Button from "@/components/Button.astro";
import type { CollectionEntry } from "astro:content";

const { posts } = Astro.props;
const tags: Array<[string, number]> = [
  ...posts
    .flatMap((article: CollectionEntry<"blog">) => article.data.tags ?? [])
    .reduce((acc, e) => acc.set(e, (acc.get(e) || 0) + 1), new Map()),
].sort((a, b) => {
  return b[1] - a[1];
});
---

<main class="p-14">
  <h2 class="pt-6 pb-6 text-3xl">博文列表</h2>
  <h3>共{posts.length}篇</h3>
  <div class="flex flex-wrap gap-2">
    {tags.map(([tagName, count]) => (
      <Button url=`/tags/${encodeURIComponent(tagName)}/`>
        {tagName}({count})
      </Button>
    ))}
  </div>
  {posts.map((article: CollectionEntry<"blog">) => (
    <article class="group pb-6 pt-4">
      <span>{article.data.pubDate}</span> - <a class="hover:text-blue-400 hover:underline underline-offset-4" href=`/posts/${article.id}/`>
        {article.data.title}
      </a>
    </article>
  ))}
</main>
