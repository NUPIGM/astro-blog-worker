---
import type { CollectionEntry } from "astro:content";
import TagPill from "@/components/TagPill.astro";

const { posts } = Astro.props;
---

<main>
    <h2 class="pt-6 pb-6  font-bold">文章列表</h2>
    {posts.map((article: CollectionEntry<"blog">) => (
        <article class="group pb-6 pt-4">
            <a href={`/posts/${article.id}/`} class="block">
                <h2 class="mb-1.5  font-medium text-foreground transition-colors group-hover:text-primary">
                    {article.data.title}
                </h2>
            </a>
            <div class="mb-2 text-xs text-muted-foreground">
                <span>{article.data.description}</span>
            </div>
            <div class="flex flex-wrap items-center gap-2  leading-relaxed text-muted-foreground">
                <span>{article.data.pubDate}</span>
                {article.data.tags?.map((tag) => (
                    <TagPill tag={tag} />
                ))}
            </div>
        </article>
    ))}
</main>
