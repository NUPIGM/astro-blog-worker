---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FloatingWidget from "../components/FloatingWidget.astro";
import { fade } from "astro:transitions";
interface Props {
  title: string;
  description: string;
  navItems?: { label: string; href: string }[];
  count: number;
  tags: string[];
}
const { title, description, navItems, count, tags } = Astro.props;
---

<html lang="zh-cn">
  <head>
    <BaseHead title={title} description={description} />
  </head>

  <body
    class="m-auto max-w-5xl bg-white not-print:shadow-[0_8px_30px_rgba(0,0,0,0.12)] p-10"
  >
    <Header title={title} navItems={navItems} count={count} tags={tags} />

    <main transition:animate={fade({ duration: "0.4s" })}>
      <slot />
    </main>
    <Footer />
    <FloatingWidget />
  </body>
</html>
