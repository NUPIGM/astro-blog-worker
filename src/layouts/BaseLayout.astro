---
import { ClientRouter, fade } from "astro:transitions";
import "@/styles/global.css";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import Seo from "@/components/Seo.astro";

const { seo } = Astro.props;
const { title, detailedDescription, image, keywords, theme, noindex } = seo || {};
---

<html lang="zh-CN">
    <head>
        <Seo
            title={title}
            detailedDescription={detailedDescription}
            image={image}
            keywords={keywords}
            theme={theme}
            noindex={noindex}
        />
        <ClientRouter />
        <!-- 加载动画 -->
        <script>
        import "@/lib/loading";
        </script>
        <!-- service worker -->
        <script>
            import "@/lib/sw";
        </script>
    </head>

    <body
        transition:animate={fade({ duration: "0.25s" })}
        class="min-h-dvh w-full bg-linear-to-b from-[#8FD9E8] via-[#176B99] via-45% to-[#051729]"
    >
        <div class="relative hidden">
            <!-- 光柱 2：白 7% → 透明的垂直渐变，装饰层不拦鼠标 -->
            <div
                class="pointer-events-none absolute left-150 top-16 h-full w-25
        bg-linear-to-b from-white/7 to-transparent"
                aria-hidden="true"
            ></div>
            <!-- 光柱 2：白 7% → 透明的垂直渐变，装饰层不拦鼠标 -->
            <div
                class="pointer-events-none absolute left-80 top-16 h-full w-50
        bg-linear-to-b from-white/7 to-transparent"
                aria-hidden="true"
            ></div>
        </div>

        <Header />
        <slot />
        <Footer />
    </body>
</html>
