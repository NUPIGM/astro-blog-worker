---
// src/layouts/GridHeightLayout.astro
interface Props {
    title?: string;
    unitHeight?: number; // 允许自定义基准高度，默认 720
}

const { title = "Astro Page", unitHeight = 720 } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{title}</title>
    </head>
    <body>
        <!-- 外层控制容器，通过 data 属性把 unitHeight 传递给客户端脚本 -->
        <div id="page-wrapper" data-unit-height={unitHeight}>
            <!-- 内层包裹实际内容，flow-root 用于消除内部元素的 margin 塌陷 -->
            <main id="content-inner">
                <slot />
            </main>
        </div>
    </body>
</html>

<style>
html,
body {
    margin: 0;
    padding: 0;
}

#page-wrapper {
    min-height: 720px;
    box-sizing: border-box;
}

#content-inner {
    display: flow-root; /* 现代 CSS 方案，防止子元素 margin 溢出导致计算不准 */
}
</style>

<script>
function initGridHeight() {
    const wrapper = document.getElementById("page-wrapper");
    const inner = document.getElementById("content-inner");
    if (!wrapper || !inner) return;

    const unitHeight = Number(wrapper.dataset.unitHeight) || 720;

    const updateHeight = () => {
        // 获取内部真实高度
        const contentHeight = inner.getBoundingClientRect().height;
        // 减去 0.5px 容差，避免亚像素（如 720.05px）导致意外多进一位
        const multiple = Math.max(1, Math.ceil((contentHeight - 0.5) / unitHeight));
        wrapper.style.height = `${multiple * unitHeight}px`;
    };

    // 使用 ResizeObserver 监听内容变化（如图片异步加载、客户端交互组件展开等）
    const observer = new ResizeObserver(() => {
        updateHeight();
    });

    observer.observe(inner);
    updateHeight(); // 初始化立即执行一次
}

// 1. 常规页面加载时执行
initGridHeight();

// 2. 如果项目启用了 Astro 的 <ClientRouter /> (View Transitions)，切换页面后重新绑定
document.addEventListener("astro:page-load", initGridHeight);
</script>
