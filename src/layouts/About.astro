---
import Subtitle from "@/components/Subtitle.astro";

const title = {
    cn: "关于我",
    en: "About Me"
};
const subtitle = "我是 NUPIGM, 我想把我收藏过好玩、好用、好看的分享在这里。";
---

<main class="p-14">
    <Subtitle {title} {subtitle} />
    <a
        href="https://github.com/NUPIGM/astro-blog-worker"
        class="hover:text-primary underline-offset-4 hover:underline transition-all duration-200 text-shadow-black"
        >My GitHub</a
    >
    <div class="h-30"></div>
</main>
