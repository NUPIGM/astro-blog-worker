---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import { SITE_TITLE, AUTHOR } from "../consts";

type Props = CollectionEntry<"blog">["data"];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
const navItems = [
  { label: "博文", href: "/post/" },
  { label: "分享", href: Astro.url.toString() },
];
---

<BaseLayout
  title={title}
  description={description}
  navItems={navItems}
  count={90}
  tags={["tags"]}
>
  <!-- 版主 -->
  <main class="flex-1 leading-8">
    <p class="text-[15px] leading-relaxed text-gray-600 max-w-[90%] mb-6">
      {description}
    </p>

    <!-- 插槽：可继续放正文内容 -->
    <slot />
    <br />
    <br />
    <div
      class="ml-auto flex w-max flex-col items-start text-left text-xs text-gray-600 mb-3"
    >
      <a class="w-max">Author: {AUTHOR}</a>
      <a class="w-max">Date: {pubDate}</a>
    </div>
  </main>
</BaseLayout>
