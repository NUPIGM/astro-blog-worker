---
import type { CollectionEntry } from "astro:content";
import { Prose } from "@/components/starwind/prose";
import { AUTHOR } from "../consts";
import BaseLayout from "./BaseLayout.astro";

type Props = CollectionEntry<"blog">["data"];

const { title, description, pubDate } = Astro.props;
const navItems = [
    { label: "博文", href: "/posts/" },
    { label: "分享", href: Astro.url.toString() }
];
---

<BaseLayout title={title} description={description} navItems={navItems} count={0} tags={["tags"]}>
    <!-- 版主 -->
    <main class="flex-1 pt-4 pb-4">
        <p class="text-[15px] text-muted-foreground max-w-[90%] mb-6">
            {description}
        </p>

        <!-- 正文排版由 Starwind Prose 组件接管（替代 @tailwindcss/typography 的 .prose） -->
        <Prose class="max-w-none">
            <slot />
        </Prose>
        <br>
        <br>
        <div
            class="ml-auto flex w-max flex-col items-start text-left text-xs text-muted-foreground mb-3"
        >
            <p class="w-max">Author: {AUTHOR}</p>
            <p class="w-max">Date: {pubDate}</p>
        </div>
    </main>
</BaseLayout>
