---
import { Button } from "@/components/starwind/button";
import { Input } from "@/components/starwind/input";
import { Textarea } from "@/components/starwind/textarea";
import { Separator } from "@/components/starwind/separator";
import BaseLayout from "../layouts/BaseLayout.astro";

// A4Paper.astro
interface Message {
  name: string;
  date: string;
  content: string;
}

interface Props {
  title?: string;
  author?: string;
  date?: string;
  companyName?: string;
  messages?: Message[];
}

const {
  title = "留言板",
  author = "张三",
  date = "2026-09-17",
  companyName = "YOUR COMPANY NAME",
  messages = [
    {
      name: "李四",
      date: "2026-09-16",
      content: "页面设计很简洁，阅读体验很好，期待后续更多内容！",
    },
    {
      name: "王五",
      date: "2026-09-15",
      content: "A4 纸张的布局很有正式感，喜欢这种克制的风格。",
    },
    {
      name: "赵六",
      date: "2026-09-14",
      content: "已经收藏了，希望能多更新一些技术相关的文章。",
    },
  ],
} = Astro.props;
const navItems = [
  { label: "博文", href: "/posts/" },
  { label: "分享", href: Astro.url.toString() },
];
---

<BaseLayout
  title="留言 "
  description="查看博客中的全部标签与对应文章数量"
  navItems={navItems}
  count={messages.length}
  tags={["tags"]}
>
  <!-- 留言列表 -->
  <div class="space-y-8 mb-12">
    {
      messages.map((msg) => (
        <div class="border-b border-border pb-6 last:border-0">
          <div class="flex items-baseline justify-between mb-2">
            <span class="font-medium text-foreground">{msg.name}</span>
            <span class="text-xs text-muted-foreground">{msg.date}</span>
          </div>
          <p class="text-[15px] leading-7 text-foreground/80">{msg.content}</p>
        </div>
      ))
    }
  </div>

  <!-- 留言表单 -->
  <Separator class="mt-10" />
  <div class="pt-8">
    <h2 class="text-lg font-medium text-foreground mb-5">写下你的留言</h2>

    <!-- 纯静态站点暂无后端，表单未接入提交接口，禁用提交避免误导 -->
    <form class="space-y-5" onsubmit="return false;">
      <div>
        <label class="block text-sm text-muted-foreground mb-1.5" for="gb-name">昵称</label>
        <Input
          id="gb-name"
          type="text"
          name="name"
          required
          autocomplete="nickname"
          maxlength="32"
          size="sm"
          class="px-3 py-2 text-sm"
          placeholder="请输入你的昵称"
        />
      </div>

      <div>
        <label class="block text-sm text-muted-foreground mb-1.5" for="gb-content">留言内容</label>
        <Textarea
          id="gb-content"
          name="content"
          required
          rows="4"
          maxlength="500"
          size="sm"
          class="px-3 py-2 text-sm resize-none"
          placeholder="说点什么吧..."></Textarea>
      </div>

      <div class="flex items-center gap-3">
        <Button
          type="submit"
          variant="primary"
          size="sm"
          disabled
          aria-disabled="true"
          class="px-6"
        >
          提交留言
        </Button>
        <span class="text-xs text-muted-foreground">留言接口尚未接入，暂时无法提交。</span>
      </div>
    </form>
  </div>
</BaseLayout>
