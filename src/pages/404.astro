---
import BaseLayout from "@/layouts/BaseLayout.astro";

const seo = {
    title: "页面未找到 404",
    detailedDescription: " 404 错误，请检查您输入的网址是否正确。",
    image: "/",
    keywords: ["Astro", "博客", "个人网站", "泡泡鱼博客", "泡泡鱼个人网站", "泡泡鱼技术分享"]
};
---

<BaseLayout {seo}>
    <main class="not-found">
        <h1>哎呀，页面游丢了！</h1>
        <p>这里没有你要找的页面，不如来玩一局大鱼吃小鱼吧。</p>
        <div class="game-info">
            <span>使用方向键或 WASD 移动，吃掉比你小的鱼！</span>
            <span id="game-status" aria-live="polite">得分：0</span>
        </div>
        <canvas id="fish-game" width="800" height="460" tabindex="0" aria-label="大鱼吃小鱼游戏区域"></canvas>
        <button id="restart-game" type="button">重新开始</button>
        <a class="home-link" href="/">返回首页</a>
    </main>

    <style>
        .not-found {
            width: min(900px, calc(100% - 32px));
            margin: 48px auto;
            text-align: center;
        }

        .not-found h1 {
            margin-bottom: 8px;
        }

        .game-info {
            display: flex;
            justify-content: space-between;
            gap: 12px;
            margin: 24px 0 12px;
            text-align: left;
        }

        #fish-game {
            display: block;
            width: 100%;
            height: auto;
            border: 2px solid #65c7d0;
            border-radius: 16px;
            background: #dff8ff;
            outline-offset: 4px;
        }

        #restart-game,
        .home-link {
            display: inline-block;
            margin: 18px 8px 0;
            padding: 10px 18px;
            border: 0;
            border-radius: 999px;
            background: #1596a5;
            color: white;
            font: inherit;
            text-decoration: none;
            cursor: pointer;
        }

        .home-link {
            background: #64748b;
        }

        @media (max-width: 600px) {
            .not-found {
                margin: 28px auto;
            }

            .game-info {
                flex-direction: column;
            }
        }
    </style>

    <script>
        const canvas = document.querySelector("#fish-game");
        const status = document.querySelector("#game-status");
        const restartButton = document.querySelector("#restart-game");
        const context = canvas?.getContext("2d");

        if (canvas && context && status && restartButton) {
            const width = canvas.width;
            const height = canvas.height;
            const keys = new Set();
            let player;
            let fish;
            let score;
            let animation;
            let finished;

            function makeFish(size) {
                return {
                    x: Math.random() * width,
                    y: 35 + Math.random() * (height - 70),
                    size,
                    speed: 0.6 + Math.random() * 1.3,
                    direction: Math.random() < 0.5 ? -1 : 1,
                    color: ["#ff9b54", "#e879a9", "#8b7cf6", "#48b9a5"][Math.floor(Math.random() * 4)]
                };
            }

            function resetGame() {
                player = { x: width / 2, y: height / 2, size: 18, speed: 3.2 };
                fish = Array.from({ length: 12 }, () => makeFish(7 + Math.random() * 20));
                score = 0;
                finished = false;
                status.textContent = "得分：0";
                if (animation) cancelAnimationFrame(animation);
                draw();
            }

            function drawFish(item, isPlayer = false) {
                const { x, y, size } = item;
                context.save();
                context.translate(x, y);
                context.scale(item.direction || 1, 1);
                context.fillStyle = item.color || "#168da5";
                context.beginPath();
                context.ellipse(0, 0, size * 1.35, size * 0.78, 0, 0, Math.PI * 2);
                context.fill();
                context.beginPath();
                context.moveTo(-size, 0);
                context.lineTo(-size * 1.9, -size * 0.75);
                context.lineTo(-size * 1.9, size * 0.75);
                context.closePath();
                context.fill();
                context.fillStyle = "white";
                context.beginPath();
                context.arc(size * 0.72, -size * 0.18, Math.max(2.5, size * 0.15), 0, Math.PI * 2);
                context.fill();
                context.fillStyle = "#17324d";
                context.beginPath();
                context.arc(size * 0.78, -size * 0.18, Math.max(1.3, size * 0.075), 0, Math.PI * 2);
                context.fill();
                context.restore();
                if (isPlayer) {
                    context.fillStyle = "#17324d";
                    context.font = "14px sans-serif";
                    context.textAlign = "center";
                    context.fillText("你", x, y - size - 12);
                }
            }

            function draw() {
                context.clearRect(0, 0, width, height);
                context.fillStyle = "rgba(255, 255, 255, 0.55)";
                for (let i = 0; i < 18; i++) {
                    const x = (i * 97 + 31) % width;
                    const y = (i * 67 + 24) % height;
                    context.beginPath();
                    context.arc(x, y, 2 + (i % 3), 0, Math.PI * 2);
                    context.fill();
                }
                fish.forEach((item) => drawFish(item));
                drawFish(player, true);
                if (finished) {
                    context.fillStyle = "rgba(12, 45, 70, 0.72)";
                    context.fillRect(0, 0, width, height);
                    context.fillStyle = "white";
                    context.font = "bold 32px sans-serif";
                    context.textAlign = "center";
                    context.fillText("太棒了！你成了海洋霸主！", width / 2, height / 2);
                }
            }

            function update() {
                if (finished) return;
                const dx = (keys.has("ArrowRight") || keys.has("d") ? 1 : 0) - (keys.has("ArrowLeft") || keys.has("a") ? 1 : 0);
                const dy = (keys.has("ArrowDown") || keys.has("s") ? 1 : 0) - (keys.has("ArrowUp") || keys.has("w") ? 1 : 0);
                const length = Math.hypot(dx, dy) || 1;
                player.x = Math.max(player.size * 2, Math.min(width - player.size * 2, player.x + (dx / length) * player.speed));
                player.y = Math.max(player.size, Math.min(height - player.size, player.y + (dy / length) * player.speed));

                fish.forEach((item) => {
                    item.x += item.speed * item.direction;
                    if (item.x < -item.size * 2) item.x = width + item.size * 2;
                    if (item.x > width + item.size * 2) item.x = -item.size * 2;
                    if (Math.hypot(player.x - item.x, player.y - item.y) < player.size + item.size * 0.7) {
                        if (player.size > item.size * 1.12) {
                            player.size += Math.max(1, item.size * 0.12);
                            score += 10;
                            status.textContent = `得分：${score}`;
                            Object.assign(item, makeFish(7 + Math.random() * Math.min(24, player.size * 1.4)));
                            if (score >= 100) {
                                finished = true;
                                status.textContent = `得分：${score}，通关！`;
                            }
                        } else if (item.size > player.size * 1.12) {
                            player.size = Math.max(10, player.size - 2);
                            Object.assign(item, makeFish(Math.max(14, item.size)));
                        }
                    }
                });
                draw();
                animation = requestAnimationFrame(update);
            }

            window.addEventListener("keydown", (event) => {
                const key = event.key.length === 1 ? event.key.toLowerCase() : event.key;
                if (["ArrowUp", "ArrowDown", "ArrowLeft", "ArrowRight"].includes(key)) event.preventDefault();
                keys.add(key);
            });
            window.addEventListener("keyup", (event) => {
                const key = event.key.length === 1 ? event.key.toLowerCase() : event.key;
                keys.delete(key);
            });
            restartButton.addEventListener("click", resetGame);

            resetGame();
            animation = requestAnimationFrame(update);
        }
    </script>
</BaseLayout>
