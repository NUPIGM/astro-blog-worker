---
import { getCollection } from "astro:content";
import { Badge } from "@/components/starwind/badge";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = await getCollection("blog");
const tags: Array<[string, number]> = [
  ...posts
    .flatMap((article) => article.data.tags ?? [])
    .reduce((acc, e) => acc.set(e, (acc.get(e) || 0) + 1), new Map()),
].sort((a, b) => {
  return b[1] - a[1];
});

const navItems = [
  { label: "博文", href: "/posts/" },
  { label: "标签", href: "/tags/" },
];
---

<BaseLayout
  title="全部标签 "
  description="查看博客中的全部标签与对应文章数量"
  navItems={navItems}
  count={tags.length}
  tags={["tags"]}
>
  <div class="wrapper">
    <div class="tags-container max-w-3xl mx-auto py-8">
      <h1 class="text-3xl font-bold text-foreground mb-8">全部标签</h1>
      <div class="flex flex-wrap gap-3">
        {
          tags.map(([tagName, count]) => (
            <Badge
              href={`/tags/${encodeURIComponent(tagName)}/`}
              tone="neutral"
              appearance="outline"
              size="md"
              class="gap-2 bg-muted px-4 py-2 text-sm text-foreground/80 transition hover:border-primary/30 hover:bg-primary/10 hover:text-primary"
            >
              <span>{tagName}</span>
              <span class="rounded-full bg-secondary px-2 py-0.5 text-xs text-secondary-foreground">
                {count}
              </span>
            </Badge>
          ))
        }
      </div>
    </div>
  </div>
</BaseLayout>
