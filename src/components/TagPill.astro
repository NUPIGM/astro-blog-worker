---
import { Badge } from "@/components/starwind/badge";

interface Props {
  tag: string;
  href?: string;
  class?: string;
}

const {
  tag,
  href = `/tags/${encodeURIComponent(tag)}/`,
  class: className = "",
} = Astro.props;
---

<Badge
  href={href}
  size="sm"
  tone="neutral"
  appearance="outline"
  class:list={[
    "bg-muted px-2.5 py-1 text-xs text-foreground/80 transition hover:border-primary/30 hover:bg-primary/10 hover:text-primary",
    className,
  ]}
>
  {tag}
</Badge>
