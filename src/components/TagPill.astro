---
interface Props {
  tag: string;
  href?: string;
  class?: string;
}

const {
  tag,
  href = `/tags/${encodeURIComponent(tag)}/`,
  class: className = "",
} = Astro.props;
---

<a
  href={href}
  class:list={[
    "inline-flex items-center rounded-full border border-gray-200 bg-gray-50 px-2.5 py-1 text-xs text-gray-700 transition hover:border-blue-300 hover:bg-blue-50 hover:text-blue-600",
    className,
  ]}
>
  {tag}
</a>
