        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path
          d="M4 6.5A2.5 2.5 0 0 1 6.5 4h11A2.5 2.5 0 0 1 20 6.5v11a2.5 2.5 0 0 1-2.5 2.5h-11A2.5 2.5 0 0 1 4 17.5v-11Z"
        ></path>
        <path d="m5 7 7 5 7-5"></path>
      </svg>
      <span>邮箱/联系我</span>
    </a>

    <a
      href="https://t.me/seekknowledge_com"
      target="_blank"
      rel="noreferrer"
      class="glass-button flex items-center gap-2 rounded-full px-3 py-2 text-sm font-medium text-slate-700 no-underline transition-all duration-300 hover:-translate-y-0.5 hover:shadow-[0_12px_30px_rgba(168,85,247,0.2)]"
      aria-label="加TG群"
      title="加TG群"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-4 w-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M16 19v-1a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v1"></path>
        <circle cx="9.5" cy="7" r="3.5"></circle>
