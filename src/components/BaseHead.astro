---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import Seo from "./Seo.astro";

interface Props {
    title: string;
    description: string;
    image?: string;
    keywords?: string[];
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// 默认分享图已压到 1200x630 / 约 35KB，替代原先 224KB 的 logo.png
const { title, description, image = "/og-image.jpg", keywords } = Astro.props;

const ogImage = new URL(image, Astro.site ?? Astro.url);
---

<Seo title={title} description={description} image={ogImage} keywords={keywords} />

<ClientRouter />
