---
/**
 * PixelNav —— QQTANG 像素风导航条（Astro 移植版）
 *
 * 迁移自 index-pixel-art.html，视觉与交互保持一致：
 *   · 图形：22 条由原图像素反推的阶梯路径，走 SVG + crispEdges，永不抗锯齿
 *   · 文字：canvas 逐像素二值化成 1-bit 点阵，随条幅宽度实时重绘
 *
 * 与原页面的两处结构差异（为了能被放进任意页面）：
 *   1. 渐变色天空、抖动纹理、全屏居中全部收进 .qn 根节点，不碰 body
 *   2. 字体由 base64 内嵌改为引用 /fonts 下的 woff2，组件体积从 1.9MB 降到约 30KB
 */
export interface NavItem {
    label: string;
    href: string;
}

interface Props {
    /** 导航项，最多 9 个（几何槽位固定为 9，多出的会被忽略） */
    items?: NavItem[];
    /** 站点标识，画进左侧胶囊；建议 ≤ 6 个字符，否则会溢出白色区域 */
    brand?: string;
    /** 标识下方小字 */
    brandSub?: string;
    brandHref?: string;
    /** 左下角署名，留空则不显示 */
    credit?: string;
    /** 导航条整体的无障碍名称 */
    ariaLabel?: string;
}

const {
    items = [],
    brand = "QQTANG",
    brandSub = "QQTANG.QQ.COM",
    brandHref = "https://qqtang.qq.com",
    credit = "QQTANG.QQ.COM · PIXEL REMAKE",
    ariaLabel = "主导航"
} = Astro.props;

/** 默认 9 项，对应原图 2000 年代糖果乐园站的频道 */
const DEFAULT_ITEMS: NavItem[] = [
    { label: "首页", href: "#首页" },
    { label: "新手入门", href: "#新手入门" },
    { label: "游戏资料", href: "#游戏资料" },
    { label: "特色模式", href: "#特色模式" },
    { label: "道具商店", href: "#道具商店" },
    { label: "活动专区", href: "#活动专区" },
    { label: "紫钻贵族", href: "#紫钻贵族" },
    { label: "糖果乐园", href: "#糖果乐园" },
    { label: "游戏论坛", href: "#游戏论坛" }
];

/**
 * 按钮在 1608×110 设计网格上的落点。
 * 这些百分比是逐个从原图量出来的，不是等距网格——第一个按钮更窄，
 * 最后一个（游戏论坛）是扁平的深色款，位置也略高，所以不要"修正"它们。
 */
const SLOT_GEOM = [
    { l: "15.92%", t: "27.273%", w: "4.602%", h: "43.636%" },
    { l: "22.512%", t: "27.273%", w: "7.711%", h: "43.636%" },
    { l: "32.214%", t: "27.273%", w: "7.711%", h: "43.636%" },
    { l: "41.915%", t: "27.273%", w: "7.711%", h: "43.636%" },
    { l: "51.617%", t: "27.273%", w: "7.711%", h: "43.636%" },
    { l: "61.318%", t: "27.273%", w: "7.711%", h: "43.636%" },
    { l: "71.02%", t: "27.273%", w: "7.711%", h: "43.636%" },
    { l: "80.721%", t: "27.273%", w: "7.711%", h: "43.636%" },
    { l: "90.423%", t: "30.909%", w: "7.96%", h: "36.364%" }
];

// 槽位固定 9 个：插画里已经画好了 9 颗按钮，锚点数量必须和它对上
const slots = SLOT_GEOM.map((g, i) => {
    const item = items[i] ?? DEFAULT_ITEMS[i];
    return { i, ...g, label: item.label, href: item.href };
});
