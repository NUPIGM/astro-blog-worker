---
const nav = [
    { name: "博文", href: "/posts/" },
    { name: "标签", href: "/tags/" },
    { name: "关于", href: "/about/" }
];

const currentPath = Astro.url.pathname;
---

<header class="flex justify-between mx-auto">
    <div class="flex items-center">
        <a class="" href="/" aria-label="Blog home">I‘m a fish oO</a>
        <i class="hero-webp"></i>
    </div>
    <nav aria-label="Main navigation">
        <ul class="flex gap-4">
            {nav.map((item) => (
                <li>
                    <a
                        id="my-webp"
                        class="bubble"
                        href={item.href}
                        aria-current={currentPath === item.href ? "page" : undefined}
                    >
                        {item.name}
                    </a>
                </li>
            ))}
            <li>
                <a
                    href="https://www.travellings.cn/go.html"
                    target="_blank"
                    rel="noopener"
                    title="开往-友链接力"
                    >🚇
                </a>
            </li>
        </ul>
    </nav>
</header>

<script is:inline type="text/javascript">
window.addEventListener("pageshow", () => {
    const boxes = document.querySelectorAll(".bubble");
    const timestamp = Date.now();
    boxes.forEach((box, index) => {
        box.style.backgroundImage = `url('/images/pixel_bubble_birth.webp?t=${timestamp}_${index}')`;
    });
});
</script>
