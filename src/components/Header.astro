---
const nav = [
    { name: "Post", href: "/posts/" },
    { name: "Tag", href: "/tags/" },
    { name: "About", href: "/about/" }
];

const currentPath = Astro.url.pathname;
---

<header class="fixed inset-x-0 top-0 flex justify-between max-w-5xl mx-auto ">
    <a class="" href="/" aria-label="Blog home">BLOG</a>
    <nav aria-label="Main navigation">
        <ul class="flex gap-4">
            {nav.map((item) => (
                <li>
                    <a
                        class=""
                        href={item.href}
                        aria-current={currentPath === item.href ? "page" : undefined}
                    >
                        {item.name}
                    </a>
                </li>
            ))}
        </ul>
    </nav>
</header>

<style>
.nav-link:hover,
.nav-link:focus-visible,
.nav-link[aria-current="page"] {
    border-color: currentColor;
}
</style>
