---
import { Separator } from "@/components/starwind/separator";

interface Props {
  title: string;
  navItems?: { label: string; href: string }[];
  count: number;
  tags: string[];
}
const { title, navItems = [], count, tags } = Astro.props;
---

<header>
  <!-- 首页 Logo -->
  <a
    href="/"
    class="inline-flex items-center h-9 w-9 justify-center rounded-full bg-brand overflow-hidden text-sm font-bold text-brand-foreground shadow-sm hover:shadow-blue-500 transition-colors duration-200"
    aria-label="前往首页"
    >HOME
  </a>

  <!-- 大标题 -->
  <h1
    class="text-4xl md:text-5xl font-bold text-center text-foreground tracking-tight max-w-2/3 mx-auto mb-12"
  >
    {title}
  </h1>

  <!-- 下方信息行 -->
  <div
    class="grid grid-cols-3 items-center text-center text-foreground/80 print:hidden"
  >
    <!-- 左侧导航 -->
    <div
      class="flex items-center justify-self-start gap-[clamp(0,0.3dvw,16px)]"
    >
      {
        navItems.map((item, index) => (
          <>
            <a
              href={item.href}
              class="cursor-pointer text-foreground/80 hover:text-primary underline-offset-4 hover:underline transition-all duration-200"
            >
              {item.label}
            </a>
            {index < navItems.length - 1 && (
              <span class="text-muted-foreground mx-1" />
            )}
          </>
        ))
      }
    </div>

    <!-- 中间文章数 -->
    <div class="text-center justify-self-center">
      {count}
    </div>

    <!-- 右侧标签 -->
    <div class="flex flex-wrap items-center justify-end gap-1">
      <a
        href="/tags/"
        class="cursor-pointer text-foreground/80 hover:text-primary underline-offset-4 hover:underline transition-all duration-200"
      >
        标签
      </a>
    </div>
  </div>

  <!-- 红色分割线 -->
  <Separator class="my-3 h-1 bg-brand" />
</header>
