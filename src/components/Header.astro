---
import Button from "./Button.astro";

const nav = [
    { name: "博文", href: "/posts/" },
    { name: "友链", href: "/guestbook/" },
    { name: "关于", href: "/about/" }
];
---

<header class="flex justify-between mx-auto bg-[#05293D]/45" aria-hidden="true">
    <div class="flex items-center">
        <a href="/" class="group flex flex-col gap-2">
            <span
                class="font-['Press_Start_2P',monospace] text-[20px] leading-none text-[#EAFBFF]
           transition-colors duration-100 ease-[steps(3,end)] group-hover:text-white"
            >
                I'm a fish oO
            </span>
            <span
                class=" text-[14px] leading-none text-[#BFE9F5]
           transition-colors duration-100 ease-[steps(3,end)] group-hover:text-[#EAFBFF]"
            >
                ooOoO · 一条鱼的笔记本
            </span>
        </a> <i class="hero-webp"></i>
    </div>
    <nav class="flex items-center" aria-label="Main navigation">
        <ul class="flex gap-4">
            {nav.map((item) => (
                <li>
                    <Button url={item.href}>{item.name}</Button>
                </li>
            ))}
            <li>
                <a
                    href="https://www.travellings.cn/go.html"
                    target="_blank"
                    rel="noopener"
                    title="开往-友链接力"
                    >🚇
                </a>
            </li>
        </ul>
    </nav>
</header>

<script is:inline type="text/javascript">
window.addEventListener("pageshow", () => {
    const boxes = document.querySelectorAll(".bubble");
    const timestamp = Date.now();
    boxes.forEach((box, index) => {
        box.style.backgroundImage = `url('/images/pixel_bubble_birth.webp?t=${timestamp}_${index}')`;
    });
});
</script>
