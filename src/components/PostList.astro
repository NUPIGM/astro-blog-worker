---
import type { CollectionEntry } from "astro:content";
import { Separator } from "@/components/starwind/separator";
import TagPill from "./TagPill.astro";

interface Props {
  posts: CollectionEntry<"blog">[];
}

const { posts } = Astro.props;
---

<div class="space-y-7">
  {
    posts.map((article) => (
      <article class="group">
        <a href={`/posts/${article.id}/`} class="block">
          <h2 class="mb-1.5 text-lg font-medium text-foreground transition-colors group-hover:text-primary">
            {article.data.title}
          </h2>
        </a>

        <div class="mb-2 text-xs text-muted-foreground">
          <span>{article.data.description}</span>
        </div>

        <div class="flex flex-wrap items-center gap-2 text-[14px] leading-relaxed text-muted-foreground">
          <span>{article.data.pubDate}</span>
          {article.data.tags?.map((tag) => (
            <TagPill tag={tag} />
          ))}
        </div>

        <Separator class="mt-6" />
      </article>
    ))
  }
</div>
